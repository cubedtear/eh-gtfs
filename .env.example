# Docker Compose settings (read automatically by `docker compose`)
COMPOSE_PROJECT_NAME=euskadi-transit
CONTAINER_NAME=euskadi-transit
# Image published by the GitHub Action. Pin a version (e.g. :1.2.0 or :sha-abc1234) to stop auto-updating
IMAGE_NAME=ghcr.io/josuloo99/eh-gtfs:latest
# always = check GitHub for a newer image on every `docker compose up`; missing = only pull if absent
PULL_POLICY=always

# Host port the web UI is published on (container always listens on 8000)
HOST_PORT=8000
# Interface to bind on the host: 127.0.0.1 = this machine only, 0.0.0.0 = whole network
BIND_ADDRESS=0.0.0.0

TZ=Europe/Madrid
RESTART_POLICY=unless-stopped

# Where the imported timetables (SQLite) are stored inside /app/data:
#  - a plain name (default)  -> Docker named volume, nothing else to configure
#  - a path (./data, /srv/transit)  -> bind mount on the host; the folder must be writable by APP_UID:APP_GID
DATA_PATH=transit-data
# User/group the app runs as. For a host bind mount set these to your own ids (`id -u`, `id -g`)
APP_UID=10001
APP_GID=10001
